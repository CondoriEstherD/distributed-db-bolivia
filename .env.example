# Copiar a .env (python gestion.py lo hace la primera vez) y cambiar las contraseñas.
# .env NO se sube al repositorio.

# ---- Credenciales (sin espacios ni comillas) --------------------------------
PG_PASSWORD=Cambiar_Superusuario_2026
APP_PASSWORD=Cambiar_Aplicacion_2026

# ---- Topología ---------------------------------------------------------------
# lab : los 6 nodos en este equipo (desarrollo).
# red : nodos repartidos en varios equipos unidos por Tailscale (despliegue/defensa).
MODO=lab

# Nodos que se ejecutan en ESTE equipo (lp, sc, cb, tj, or, be).
NODOS_LOCALES=lp,sc,cb,tj,or,be

# Interfaz donde se publican los puertos: 127.0.0.1 en lab, 0.0.0.0 en red.
BIND_IP=127.0.0.1

# Dirección y puerto de cada nodo vistos desde los programas Python y desde los
# otros equipos. En modo red: IP de Tailscale (100.x.y.z) del equipo que lo aloja.
HOST_LP=127.0.0.1
PORT_LP=15431
HOST_SC=127.0.0.1
PORT_SC=15432
HOST_CB=127.0.0.1
PORT_CB=15433
HOST_TJ=127.0.0.1
PORT_TJ=15434
HOST_OR=127.0.0.1
PORT_OR=15435
HOST_BE=127.0.0.1
PORT_BE=15436
